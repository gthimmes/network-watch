<Project Sdk="Microsoft.NET.Sdk">

  <!-- nwctl: command-line client for the service's local API (portable; also the headless/server UI). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nwctl</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>../NetworkWatch.Tray/networkwatch.ico</ApplicationIcon>
    <Product>Network Watch</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkWatch.Core\NetworkWatch.Core.csproj" />
  </ItemGroup>

</Project>
