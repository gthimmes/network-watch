<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- The product: runs headless as a Windows service (LocalSystem). The tray and CLI are API clients. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Version>0.1.0</Version>
    <ApplicationIcon>../NetworkWatch.Tray/networkwatch.ico</ApplicationIcon>
    <Product>Network Watch</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkWatch.Collectors.Windows\NetworkWatch.Collectors.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

</Project>
